@model IEnumerable<OnlineShopTAR25.Models.Spaceship.SpaceshipIndexViewModel>


@{
    int rowNumber = 1;
}

<div class="h1">
    Spaceship
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td>"@rowNumber"</td>
                    <td>@spaceship.Name</td>
                    <td>@spaceship.Classification</td>
                    <td>@spaceship.BuiltDate</td>
                    <td>@spaceship.Crew</td>
                    <td>
                        <a asp-action="Delete" asp-controller="Spaceship" type="" class="btn-outline-dark btn btn-danger">Delete</a>
                        <a asp-action="Details" asp-controller="Spaceship" type="" class="btn-outline-dark btn btn-info">Details</a>
                        <a asp-action="Update" asp-controller="Spaceship" type="" class="btn btn-outline-dark btn-warning">Update</a>


                    </td>
                </tr>
                    rowNumber++;
                }
        </tbody>
    </table>
</form>
<a asp-action="Index" asp-controller="Home" type="" class="btn btn-primary  btn-lg  btn-outline-dark ">Back to home</a>


<a asp-action="create" asp-controller="Spaceship" type="" class="btn btn-primary  btn-lg  btn-outline-dark ">Create</a>