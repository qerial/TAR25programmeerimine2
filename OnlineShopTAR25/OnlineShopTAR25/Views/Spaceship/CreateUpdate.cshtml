@model OnlineShopTAR25.Models.Spaceship.SpaceshipCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Spaceship Update</h1>
}
else
{
    <h1>Spaceship Create</h1>    
}


<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Classification" class="control-label"></label>
        <input asp-for="Classification" class="form-control" />
        <span asp-validation-for="Classification" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BuiltDate" class="control-label"></label>
        <input asp-for="BuiltDate" class="form-control" />
        <span asp-validation-for="BuiltDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Crew" class="control-label"></label>
        <input asp-for="Crew" class="form-control" />
        <span asp-validation-for="Crew" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EnginePower" class="control-label"></label>
        <input asp-for="EnginePower" class="form-control" />
        <span asp-validation-for="EnginePower" class="text-danger"></span>
    </div>
    
    See koht on failide üleslaadimise vorm.
    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>
    </div>


    <div>
    @foreach (var images in Model.Image)
        {
            <partial name="_Images" model="images" />
            <input asp-action="removeImage" asp-controller="spaceship" asp-route-imageId="@images.ImageId"
            type="submit" class="btn btn-danger" value="Remove Image" />
        }
    </div>

    <hr />

    @if (Model.Id.HasValue)
    {
        <input asp-action="Update" asp-controller="spaceship" type="submit" class="btn btn-primary btn-lg btn-outline-dark" value="Update" />

    }
    else
    {
        <input asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary btn-lg btn-outline-dark" value="Create" />
    }



        <div class="form-group">
        <a asp-action="Index" asp-controller="Spaceship" type="" class="btn btn-primary btn-lg btn-outline-dark">Back to list</a>
    </div>
</form>


