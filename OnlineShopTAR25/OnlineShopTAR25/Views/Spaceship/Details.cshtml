@model IEnumerable<OnlineShopTAR25.Models.Spaceship.SpaceshipDetailsViewModel>
@{
    ViewData["Title"] = "Details Page";
}
<h1>@ViewData["Title"]</h1>
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td>@spaceship.Name</td>
                    <td>@spaceship.Classification</td>
                    <td>@spaceship.BuiltDate</td>
                    <td>@spaceship.Crew</td>
                    <td>
                </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="form-group">
        <a asp-action="Index" asp-controller="Spaceship" type="" class="btn btn-success">Back to list</a>
    </div>


