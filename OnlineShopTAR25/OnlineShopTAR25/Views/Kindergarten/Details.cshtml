@model OnlineShopTAR25.Models.Kindergarten.KindergartenDetailsViewModel

@{
    ViewData["Title"] = "Kindergarten Details";
}

<div class="home-page kindergarten-page">

    <div class="network-background">
        <canvas id="networkCanvas"
                aria-label="Interactive rotating network sphere"
                role="img"></canvas>
    </div>

    <div class="home-overlay"></div>

    <nav class="home-nav">
        <a asp-controller="Home" asp-action="Index" class="home-brand">
            ONLINE<span>SHOP</span>
        </a>

        <div class="home-nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a asp-controller="Kindergarten" asp-action="Index" class="active">
                Kindergarten
            </a>
        </div>
    </nav>

    <main class="kindergarten-content">

        <p class="home-eyebrow">GET TO KNOW YOUR GROUP</p>

        <h1 class="kindergarten-title">
            Group<br />
            <span>Details.</span>
        </h1>

        <p class="home-description">
            Explore group information, meet the teacher, and view uploaded images.
        </p>

        <div class="kindergarten-toolbar">
            <div>
                <span class="kindergarten-label">GROUP OVERVIEW</span>
                <p class="kindergarten-subtitle">
                    @Model.GroupName
                </p>
            </div>

            <a asp-action="Update"
                   asp-controller="Kindergarten"
                   asp-route-id="@Model.Id"
                   class="home-button home-button-primary">
                EDIT GROUP
            </a>
        </div>

        <div class="kindergarten-table-wrapper">
            <div class="kindergarten-details-grid">

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">GROUP ID</span>
                    <p>@Model.Id</p>
                </div>

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">GROUP NAME</span>
                    <p>@Model.GroupName</p>
                </div>

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">CHILDREN</span>
                    <p>
                        <span class="children-badge">
                            @Model.ChildrenCount
                        </span>
                    </p>
                </div>

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">KINDERGARTEN</span>
                    <p>@Model.KindergartenName</p>
                </div>

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">TEACHER</span>
                    <p>@Model.TeacherName</p>
                </div>

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">CREATED AT</span>
                    <p>@Model.CreatedAt</p>
                </div>

                <div class="kindergarten-detail-item">
                    <span class="kindergarten-label">LAST UPDATED</span>
                    <p>@Model.UpdatedAt</p>
                </div>

            </div>
        </div>

        <div class="kindergarten-toolbar">
            <div>
                <span class="kindergarten-label">GALLERY</span>
                <p class="kindergarten-subtitle">Group images</p>
            </div>
        </div>

        <div class="kindergarten-images">
            @if (Model.Images != null && Model.Images.Any())
            {
                @foreach (var image in Model.Images)
                {
                    <div class="kindergarten-image-item">
                        <partial name="_Images" model="image" />
                    </div>
                }
            }
            else
            {
                <p class="home-description">
                    No images have been uploaded for this group.
                </p>
            }
        </div>

        <div class="kindergarten-bottom">
            <a asp-action="Index"
                   asp-controller="Kindergarten"
                   class="home-button home-button-secondary">
                ← BACK TO GROUPS
            </a>

            <span class="home-hint">
                <span class="home-hint-dot"></span>
                GROUP #@Model.Id
            </span>
        </div>

    </main>

    <footer class="home-footer">
        <span>ONLINE SHOP TAR25</span>
        <span>BUILT TO EXPLORE</span>
    </footer>

</div>

@section Scripts {
    <script src="~/js/network-background.js"
            asp-append-version="true"></script>
}