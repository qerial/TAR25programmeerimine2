@model OnlineShopTAR25.Models.Kindergarten.KindergartenDetailsViewModel

<h1>Details</h1>

<div>
    <h4>Kindergarten</h4>
    <hr />

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="GroupName" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.GroupName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="ChildrenCount" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.ChildrenCount)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="KindergartenName" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.KindergartenName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="TeacherName" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.TeacherName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="CreatedAt" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.CreatedAt)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="UpdatedAt" class="col-sn-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.UpdatedAt)
        </div>
    </dl>
</div>

<div>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Images" class="col-sn-2 col-form-label"></label>
        </div>
    </dl>
</div>

@foreach (var images in Model.Images)
{
    <partial name="_Images" model="images" />
    <br />
}

<div class="form-group">
    <a asp-action="Index" asp-controller="Kindergarten" class="btn btn-success">
        Back to list
    </a>
</div>