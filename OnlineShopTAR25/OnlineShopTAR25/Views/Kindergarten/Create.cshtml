@model OnlineShopTAR25.Models.Kindergarten.KindergartenCreateViewModel

@{
    ViewData["Title"] = "Create Kindergarten";
}

<div class="home-page kindergarten-page">

    <div class="network-background">
        <canvas id="networkCanvas"
                aria-label="Interactive rotating network sphere"
                role="img"></canvas>
    </div>

    <div class="home-overlay"></div>

    <nav class="home-nav">
        <a asp-controller="Home" asp-action="Index" class="home-brand">
            ONLINE<span>SHOP</span>
        </a>

        <div class="home-nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a asp-controller="Kindergarten" asp-action="Index" class="active">
                Kindergarten
            </a>
        </div>
    </nav>

    <main class="kindergarten-content">

        <p class="home-eyebrow">EVERY GREAT JOURNEY STARTS SOMEWHERE</p>

        <h1 class="kindergarten-title">
            Create<br />
            <span>Group.</span>
        </h1>

        <p class="home-description">
            Set up a new kindergarten group, add its teacher, and upload images.
        </p>

        <div class="kindergarten-toolbar">
            <div>
                <span class="kindergarten-label">NEW ENTRY</span>
                <p class="kindergarten-subtitle">
                    Group information
                </p>
            </div>
        </div>

        <div class="kindergarten-table-wrapper kindergarten-form-wrapper">

            <form asp-action="Create"
                  asp-controller="Kindergarten"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="kindergarten-form-grid">

                    <div class="kindergarten-form-group">
                        <label asp-for="GroupName"></label>
                        <input asp-for="GroupName" class="form-control" />
                        <span asp-validation-for="GroupName"
                              class="text-danger"></span>
                    </div>

                    <div class="kindergarten-form-group">
                        <label asp-for="ChildrenCount"></label>
                        <input asp-for="ChildrenCount"
                               class="form-control" />
                        <span asp-validation-for="ChildrenCount"
                              class="text-danger"></span>
                    </div>

                    <div class="kindergarten-form-group">
                        <label asp-for="KindergartenName"></label>
                        <input asp-for="KindergartenName"
                               class="form-control" />
                        <span asp-validation-for="KindergartenName"
                              class="text-danger"></span>
                    </div>

                    <div class="kindergarten-form-group">
                        <label asp-for="TeacherName"></label>
                        <input asp-for="TeacherName" class="form-control" />
                        <span asp-validation-for="TeacherName"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="kindergarten-form-group kindergarten-upload">
                    <label asp-for="Files">Upload Group Images</label>
                    <input asp-for="Files"
                           class="form-control"
                           type="file"
                           multiple />
                    <span asp-validation-for="Files"
                          class="text-danger"></span>
                </div>

                @if (Model.Image != null && Model.Image.Any())
                {
                    <div class="kindergarten-toolbar">
                        <div>
                            <span class="kindergarten-label">SELECTED IMAGES</span>
                            <p class="kindergarten-subtitle">
                                Preview existing images
                            </p>
                        </div>
                    </div>

                    <div class="kindergarten-images">
                        @foreach (var file in Model.Image)
                        {
                            <div class="kindergarten-image-item">
                                <partial name="_Images" model="file" />
                            </div>
                        }
                    </div>
                }

                <div class="kindergarten-form-actions">
                    <button type="submit"
                            class="home-button home-button-primary">
                        CREATE GROUP
                    </button>

                    <a asp-action="Index"
                           asp-controller="Kindergarten"
                           class="home-button home-button-secondary">
                        CANCEL
                    </a>
                </div>

            </form>

        </div>

        <div class="kindergarten-bottom">
            <a asp-action="Index"
                   asp-controller="Kindergarten"
                   class="home-button home-button-secondary">
                ← BACK TO GROUPS
            </a>

            <span class="home-hint">
                <span class="home-hint-dot"></span>
                NEW GROUP
            </span>
        </div>

    </main>

    <footer class="home-footer">
        <span>ONLINE SHOP TAR25</span>
        <span>BUILT TO EXPLORE</span>
    </footer>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/network-background.js"
            asp-append-version="true"></script>
}