
@model OnlineShopTAR25.Models.Kindergarten.KindergartenCreateViewModel

<h1>Create Kindergarten</h1>

<div>
    <form asp-action="Create" asp-controller="Kindergarten"
          method="post" enctype="multipart/form-data">

        <div class="form-group row">
            <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="GroupName" class="form-control" />
                <span asp-validation-for="GroupName" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row">
            <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="ChildrenCount" class="form-control" />
                <span asp-validation-for="ChildrenCount" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row">
            <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="KindergartenName" class="form-control" />
                <span asp-validation-for="KindergartenName" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row">
            <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="TeacherName" class="form-control" />
                <span asp-validation-for="TeacherName" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="form-group row">
            <label asp-for="Files" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <input asp-for="Files" class="form-control" type="file" multiple />
            </div>
        </div>
        <br />

        @foreach (var file in Model.Image)
        {
            <partial name="_Images" model="file" />
            <br />
        }

        <input type="submit" class="btn btn-success" value="Create" />

        <a asp-action="Index" asp-controller="Kindergarten"
           class="btn btn-success">Back to list</a>

    </form>
</div>