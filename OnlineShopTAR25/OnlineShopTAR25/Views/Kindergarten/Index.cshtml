@model IEnumerable<OnlineShopTAR25.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergarten";
    int rowNumber = 1;
}

<div class="home-page kindergarten-page">

    <!-- Animated background -->
    <div class="network-background">
        <canvas id="networkCanvas"
                aria-label="Interactive rotating network sphere"
                role="img">
        </canvas>
    </div>

    <div class="home-overlay"></div>

    <!-- Navigation -->
    <nav class="home-nav">
        <a asp-controller="Home"
               asp-action="Index"
               class="home-brand">
            ONLINE<span>SHOP</span>
        </a>

        <div class="home-nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a asp-controller="Kindergarten" asp-action="Index"
               class="active">Kindergarten</a>
        </div>
    </nav>

    <!-- Kindergarten content -->
    <main class="kindergarten-content">

        <p class="home-eyebrow">A WORLD OF POSSIBILITIES</p>

        <h1 class="kindergarten-title">
            Kindergarten<br />
            <span>Groups.</span>
        </h1>

        <p class="home-description">
            Manage kindergarten groups, explore their details,
            and keep track of children and teachers.
        </p>

        <!-- Actions -->
        <div class="kindergarten-toolbar">
            <div>
                <span class="kindergarten-label">OVERVIEW</span>
                <p class="kindergarten-subtitle">
                    Your kindergarten groups
                </p>
            </div>

            <a asp-action="Create"
                   asp-controller="Kindergarten"
                   class="home-button home-button-primary">
                + CREATE GROUP
            </a>
        </div>

        <!-- Groups table -->
        <div class="kindergarten-table-wrapper">
            <div class="table-responsive">
                <table class="kindergarten-table">
                    <thead>
                        <tr>
                            <th>Nr</th>
                            <th>Group Name</th>
                            <th>Children</th>
                            <th>Kindergarten</th>
                            <th>Teacher</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var kindergarten in Model)
                            {
                                <tr>
                                    <td class="row-number">
                                        @rowNumber
                                    </td>

                                    <td class="group-name">
                                        @kindergarten.GroupName
                                    </td>

                                    <td>
                                        <span class="children-badge">
                                            @kindergarten.ChildrenCount
                                        </span>
                                    </td>

                                    <td>
                                        @kindergarten.KindergartenName
                                    </td>

                                    <td>
                                        @kindergarten.TeacherName
                                    </td>

                                    <td>
                                        @kindergarten.CreatedAt
                                    </td>

                                    <td>
                                        @kindergarten.UpdatedAt
                                    </td>

                                    <td>
                                        <div class="kindergarten-actions">
                                            <a asp-action="Details"
                                                   asp-controller="Kindergarten"
                                                   asp-route-id="@kindergarten.Id"
                                                   class="table-action details-action">
                                                Details
                                            </a>

                                            <a asp-action="Update"
                                                   asp-controller="Kindergarten"
                                                   asp-route-id="@kindergarten.Id"
                                                   class="table-action update-action">
                                                Update
                                            </a>

                                            <a asp-action="Delete"
                                                   asp-controller="Kindergarten"
                                                   asp-route-id="@kindergarten.Id"
                                                   class="table-action delete-action">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                rowNumber++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="empty-state">
                                    <span>No kindergarten groups found.</span>
                                    <a asp-action="Create"
                                           asp-controller="Kindergarten">
                                        Create your first group →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="kindergarten-bottom">
            <a asp-action="Index"
                   asp-controller="Home"
                   class="home-button home-button-secondary">
                ← BACK TO HOME
            </a>

            <span class="home-hint">
                <span class="home-hint-dot"></span>
                @((rowNumber - 1)) GROUPS DISPLAYED
            </span>
        </div>

    </main>

    <!-- Footer -->
    <footer class="home-footer">
        <span>ONLINE SHOP TAR25</span>
        <span>BUILT TO EXPLORE</span>
    </footer>

</div>

@section Scripts {
    <script src="~/js/network-background.js"
            asp-append-version="true"></script>
}
