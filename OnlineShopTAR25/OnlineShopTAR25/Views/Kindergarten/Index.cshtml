@model IEnumerable<OnlineShopTAR25.Models.Kindergarten.KindergartenIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold">Kindergarten</h1>
        <p class="text-muted">Kindergarten groups overview</p>
    </div>

    <form method="get">
        <div class="table-responsive shadow rounded">
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nr</th>
                        <th>GroupName</th>
                        <th>ChildrenCount</th>
                        <th>KindergartenName</th>
                        <th>TeacherName</th>
                        <th>CreatedAt</th>
                        <th>UpdatedAt</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var KinderGarten in Model)
                    {
                        <tr>
                            <td class="fw-bold">@rowNumber</td>
                            <td>@KinderGarten.GroupName</td>
                            <td>@KinderGarten.ChildrenCount</td>
                            <td>@KinderGarten.KindergartenName</td>
                            <td>@KinderGarten.TeacherName</td>
                            <td>@KinderGarten.CreatedAt</td>
                            <td>@KinderGarten.UpdatedAt</td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details"
                                       asp-controller="Kindergarten"
                                       asp-route-id="@KinderGarten.Id"
                                       class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Update"
                                       asp-controller="Kindergarten"
                                       asp-route-id="@KinderGarten.Id"
                                       class="btn btn-warning btn-sm">
                                        Update
                                    </a>

                                    <a asp-action="Delete"
                                       asp-controller="Kindergarten"
                                       asp-route-id="@KinderGarten.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>

                        rowNumber++;
                    }
                </tbody>
            </table>
        </div>
    </form>

    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Index"
           asp-controller="Home"
           class="btn btn-outline-secondary">
            ← Back to home
        </a>

        <a asp-action="Create"
           asp-controller="Kindergarten"
           class="btn btn-success">
            + Create
        </a>
    </div>

</div>
