@model OnlineShopTAR25.Models.Kindergarten.ImageViewModel

@{
    var photoPaths = "~/multipleFileUpload/" + (Model.FilePath ?? "noimage.jpg");
}


<div class="form-group row col-sm-4 offset-2">
    <div>@Model.FilePath</div>
    <img class="card-image-top" src="@photoPaths" alt="Image" asp-append-version="true" />

</div>