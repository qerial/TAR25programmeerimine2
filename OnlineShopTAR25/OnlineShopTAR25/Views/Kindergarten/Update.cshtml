@model OnlineShopTAR25.Models.Kindergarten.KindergartenUpdateViewModel

@{
    ViewData["Title"] = "Update Kindergarten";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="mb-0">Update Kindergarten</h2>
        </div>

        <div class="card-body">
            <form asp-action="Update" method="post">

                <input asp-for="Id" type="hidden" />
                <input asp-for="CreatedAt" type="hidden" />

                <div class="mb-3">
                    <label asp-for="GroupName" class="form-label">Group Name</label>
                    <input asp-for="GroupName" class="form-control" />
                    <span asp-validation-for="GroupName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ChildrenCount" class="form-label">Children Count</label>
                    <input asp-for="ChildrenCount" type="number" class="form-control" />
                    <span asp-validation-for="ChildrenCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="KindergartenName" class="form-label">Kindergarten Name</label>
                    <input asp-for="KindergartenName" class="form-control" />
                    <span asp-validation-for="KindergartenName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TeacherName" class="form-label">Teacher Name</label>
                    <input asp-for="TeacherName" class="form-control" />
                    <span asp-validation-for="TeacherName" class="text-danger"></span>
                </div>

                <input asp-for="UpdatedAt" type="hidden" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Back
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}