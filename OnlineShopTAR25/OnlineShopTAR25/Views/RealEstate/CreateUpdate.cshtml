@model OnlineShopTAR25.Models.RealEstate.RealEstateCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>RealEstate Update</h1>
}
else
{
    <h1>RealEstate Create</h1>
}


<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Area" class="control-label"></label>
        <input asp-for="Area" class="form-control" />
        <span asp-validation-for="Area" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Address" class="control-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RoomNumber" class="control-label"></label>
        <input asp-for="RoomNumber" class="form-control" />
        <span asp-validation-for="RoomNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BuildingType" class="control-label"></label>
        <input asp-for="BuildingType" class="form-control" />
        <span asp-validation-for="BuildingType" class="text-danger"></span>
    </div>
    <hr />

    @if (Model.Id.HasValue)
    {
        <input asp-action="Update" asp-controller="RealEstate" type="submit" class="btn btn-primary btn-lg btn-outline-dark" value="Update" />

    }
    else
    {
        <input asp-action="Create" asp-controller="RealEstate" type="submit" class="btn btn-primary btn-lg btn-outline-dark" value="Create" />
    }



    <div class="form-group">
        <a asp-action="Index" asp-controller="RealEstate" type="" class="btn btn-primary btn-lg btn-outline-dark">Back to list</a>
    </div>
</form>


