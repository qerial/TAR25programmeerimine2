@page
@model Numbridle.Pages.LeaderboardModel

@{
    ViewData["Title"] = "Leaderboard";
}

<main class="game-container leaderboard-page">
    <section class="hero leaderboard-hero">
        <div class="hero-content">
            <span class="eyebrow">
                <span class="status-dot"></span>
                THE HALL OF DISCOVERIES
            </span>

            <h1>
                Top <span class="gradient-text">players.</span>
            </h1>

            <p class="hero-description">
                Every discovery counts. Every point brings you closer to the top.
            </p>
        </div>

        <div class="hero-decoration" aria-hidden="true">♛</div>
    </section>

    <section class="leaderboard">
        <div class="leaderboard-title">
            <div>
                <span class="eyebrow">GLOBAL RANKINGS</span>
                <h2>Leaderboard</h2>
            </div>

            <span class="leaderboard-count">
                @Model.Players.Count player@(Model.Players.Count == 1 ? "" : "s")
            </span>
        </div>

        @if (Model.Players.Count == 0)
        {
            <div class="empty-state leaderboard-empty">
                <div class="empty-icon" aria-hidden="true">♧</div>

                <h2>The race starts with you.</h2>

                <p class="muted">
                    No scores have been recorded yet.
                    Start discovering numbers to claim your place.
                </p>

                <a class="game-button button-link" asp-page="/Index">
                    Start discovering
                    <span aria-hidden="true">↗</span>
                </a>
            </div>
        }
        else
        {
            <div class="leaderboard-heading">
                <span>RANK / PLAYER</span>
                <span>TOTAL SCORE</span>
            </div>

            <div class="leaderboard-list">
                @for (int i = 0; i < Model.Players.Count; i++)
                {
                    var player = Model.Players[i];

                    <article class="leaderboard-row @(i < 3 ? $"rank-top-{i + 1}" : "")">
                        <div class="player-identity">
                            <span class="rank-number">
                                @if (i == 0)
                                {
                                    <span aria-label="First place">♛</span>
                                }
                                else
                                {
                                    @(i + 1)
                                }
                            </span>

                            <div class="player-avatar">
                                @(string.IsNullOrEmpty(player.Username)
                                    ? "?"
                                    : player.Username[..1].ToUpperInvariant())
                            </div>

                            <div class="player-details">
                                <strong>@player.Username</strong>

                                @if (i == 0)
                                {
                                    <span class="player-subtitle">Leading the pack</span>
                                }
                                else if (i == 1)
                                {
                                    <span class="player-subtitle">Runner-up</span>
                                }
                                else if (i == 2)
                                {
                                    <span class="player-subtitle">Third place</span>
                                }
                            </div>
                        </div>

                        <div class="player-score-wrap">
                            <strong class="leaderboard-score">
                                @player.TotalScore.ToString("N0")
                            </strong>

                            <span class="score-label">POINTS</span>
                        </div>
                    </article>
                }
            </div>

            <div class="leaderboard-footer">
                <span class="status-dot"></span>
                Keep discovering. Your next score could change everything.
            </div>
        }
    </section>
</main>
